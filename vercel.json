{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "bash scripts/build_web.sh",
  "outputDirectory": "build/web",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://quan4-api.onrender.com/api/:path*" },
    { "source": "/static/:path*", "destination": "https://quan4-api.onrender.com/static/:path*" },
    { "source": "/((?!api(?:/|$)|static(?:/|$)).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/flutter_bootstrap.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
